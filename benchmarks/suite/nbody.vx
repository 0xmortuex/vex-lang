// N-body simulation of the Jovian planets (Benchmarks Game): floats and list indexing.
// Prints the energy before and after, as integers scaled by 1e9, so results compare exactly.
fn size() -> Int {
    match env.args()[0].to_int() {
        Some(n) => n,
        None => panic("size must be an integer"),
    }
}

fn energy(x: List[Float], y: List[Float], z: List[Float], vx: List[Float], vy: List[Float], vz: List[Float], m: List[Float]) -> Float {
    let mut e = 0.0;
    let n = x.len();
    for i in 0..n {
        e += 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
        for j in (i + 1)..n {
            let dx = x[i] - x[j];
            let dy = y[i] - y[j];
            let dz = z[i] - z[j];
            e -= m[i] * m[j] / (dx * dx + dy * dy + dz * dz).sqrt();
        }
    }
    e
}

fn advance(mut x: List[Float], mut y: List[Float], mut z: List[Float], mut vx: List[Float], mut vy: List[Float], mut vz: List[Float], m: List[Float], dt: Float) {
    let n = x.len();
    for i in 0..n {
        for j in (i + 1)..n {
            let dx = x[i] - x[j];
            let dy = y[i] - y[j];
            let dz = z[i] - z[j];
            let d2 = dx * dx + dy * dy + dz * dz;
            let mag = dt / (d2 * d2.sqrt());
            let mi = m[i] * mag;
            let mj = m[j] * mag;
            vx[i] = vx[i] - dx * mj;
            vy[i] = vy[i] - dy * mj;
            vz[i] = vz[i] - dz * mj;
            vx[j] = vx[j] + dx * mi;
            vy[j] = vy[j] + dy * mi;
            vz[j] = vz[j] + dz * mi;
        }
    }
    for i in 0..n {
        x[i] = x[i] + dt * vx[i];
        y[i] = y[i] + dt * vy[i];
        z[i] = z[i] + dt * vz[i];
    }
}

fn main() {
    let steps = size();
    let solar_mass = 39.47841760435743;
    let days = 365.24;
    let mut x = [0.0, 4.84143144246472082945e+00, 8.34336671801458124085e+00, 1.28943695621391310164e+01, 1.53796971148509165498e+01];
    let mut y = [0.0, -1.16032004402742839362e+00, 4.12479856412430479603e+00, -1.51111514016986312525e+01, -2.59193146099879641146e+01];
    let mut z = [0.0, -1.03622044471123109503e-01, -4.03523417825932481042e-01, -2.23307578892655733682e-01, 1.79258772950371181758e-01];
    let mut vx = [0.0, 1.66007664274403694959e-03 * days, -2.76742510726862411004e-03 * days, 2.96460137564761618652e-03 * days, 2.68067772490389322511e-03 * days];
    let mut vy = [0.0, 7.69901118419740425080e-03 * days, 4.99852801234917238954e-03 * days, 2.37847173959480950018e-03 * days, 1.62824170038242295922e-03 * days];
    let mut vz = [0.0, -6.90460016972063023554e-05 * days, 2.30417297573763262252e-05 * days, -2.96589568540237556131e-05 * days, -9.51592254519715870971e-05 * days];
    let m = [solar_mass, 9.54791938424326609124e-04 * solar_mass, 2.85885980666130812119e-04 * solar_mass, 4.36624404335156298006e-05 * solar_mass, 5.15138902046611451304e-05 * solar_mass];
    let mut px = 0.0;
    let mut py = 0.0;
    let mut pz = 0.0;
    for i in 0..5 {
        px += vx[i] * m[i];
        py += vy[i] * m[i];
        pz += vz[i] * m[i];
    }
    vx[0] = 0.0 - px / solar_mass;
    vy[0] = 0.0 - py / solar_mass;
    vz[0] = 0.0 - pz / solar_mass;
    print((energy(x, y, z, vx, vy, vz, m) * 1000000000.0).to_int());
    for _s in 0..steps {
        advance(x, y, z, vx, vy, vz, m, 0.01);
    }
    print((energy(x, y, z, vx, vy, vz, m) * 1000000000.0).to_int());
}
