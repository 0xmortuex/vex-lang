// Hash map workload on the built-in Map: insert-or-update, lookup and remove with a pseudo-random key stream.
fn size() -> Int {
    match env.args()[0].to_int() {
        Some(n) => n,
        None => panic("size must be an integer"),
    }
}

fn main() {
    let n = size();
    let modulus = 2147483648;
    let space = n / 2 + 1;
    let mut m: Map[Int, Int] = #{};
    let mut x = 42;
    for _i in 0..n {
        x = (x * 1103515245 + 12345) % modulus;
        let k = x % space;
        match m.get(k) {
            Some(v) => m.insert(k, v + 1),
            None => m.insert(k, 1),
        }
    }
    let mut sum = 0;
    let mut missing = 0;
    for k in 0..n {
        match m.get(k) {
            Some(v) => { sum = (sum + v * k) % modulus; },
            None => { missing += 1; },
        }
    }
    for k in 0..(n / 4) {
        m.remove(k);
    }
    print(sum);
    print(missing);
    print(m.len());
}
