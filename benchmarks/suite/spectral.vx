// Spectral norm (Benchmarks Game): float arithmetic through function calls.
// Prints the norm as an integer scaled by 1e9, so results compare exactly.
fn size() -> Int {
    match env.args()[0].to_int() {
        Some(n) => n,
        None => panic("size must be an integer"),
    }
}

fn a(i: Int, j: Int) -> Float {
    1.0 / ((i + j) * (i + j + 1) / 2 + i + 1).to_float()
}

fn times(v: List[Float], n: Int) -> List[Float] {
    let mut out: List[Float] = [];
    for i in 0..n {
        let mut sum = 0.0;
        for j in 0..n {
            sum += a(i, j) * v[j];
        }
        out.push(sum);
    }
    out
}

fn times_transposed(v: List[Float], n: Int) -> List[Float] {
    let mut out: List[Float] = [];
    for i in 0..n {
        let mut sum = 0.0;
        for j in 0..n {
            sum += a(j, i) * v[j];
        }
        out.push(sum);
    }
    out
}

fn main() {
    let n = size();
    let mut u: List[Float] = [];
    for _i in 0..n {
        u.push(1.0);
    }
    let mut v = u;
    for _k in 0..10 {
        v = times_transposed(times(u, n), n);
        u = times_transposed(times(v, n), n);
    }
    let mut vbv = 0.0;
    let mut vv = 0.0;
    for i in 0..n {
        vbv += u[i] * v[i];
        vv += v[i] * v[i];
    }
    print(((vbv / vv).sqrt() * 1000000000.0).to_int());
}
