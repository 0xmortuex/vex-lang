// Every error path through the real ABI, from a real Mort host. Prints one `name:status` line per case.

import vex;

fn report(name: *u8, status: i64) -> void {
    let storage: *u8 = alloc(256) as *u8;
    let buffer: []u8 = slice(storage, 256);
    let at: u64 = vex.write_text(buffer, 0, name);
    at = vex.write_text(buffer, at, ":");
    at = vex.write_text(buffer, at, vex.status_name(status));
    buffer[at] = 0;
    println(storage);
    free(storage as *void);
}

fn fails_silently(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    return 3;
}

fn wrong_tag(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    return vex.return_bool(ret, true);
}

fn accepts_str(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    return vex.return_unit(ret);
}

fn reenter(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    let api: *VexApi = ctx as *VexApi;
    let inner: VexValue = vex.of_unit();
    let status: i64 = vex.call(api, vm, "reenter_forever", 0 as *VexValue, 0, &inner);
    if status != 0 {
        vex.fail(api, vm, "re-entry failed");
        return status;
    }
    return vex.return_unit(ret);
}

fn reenter_once(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    let api: *VexApi = ctx as *VexApi;
    let inner: VexValue = vex.of_unit();
    let args: [VexValue; 1] = [vex.of_int(vex.arg_int(argv, 0) + 1)];
    let status: i64 = vex.call(api, vm, "plain", &args[0], 1, &inner);
    if status != 0 {
        vex.fail(api, vm, "inner call failed");
        return status;
    }
    return vex.return_int(ret, inner.i * 2);
}

fn re(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    let api: *VexApi = ctx as *VexApi;
    let inner: VexValue = vex.of_unit();
    let status: i64 = vex.call(api, vm, "leaf", 0 as *VexValue, 0, &inner);
    if status != 0 {
        vex.fail(api, vm, "re-entry failed");
        return status;
    }
    return vex.return_int(ret, inner.i);
}

// A host function must never be able to tear down the interpreter it is running inside.
fn stops_the_runtime(vm: *void, ctx: *void, argv: *VexValue, argc: i64, ret: *VexValue) -> i64 {
    if vex.stop() {
        return vex.return_int(ret, 1);
    }
    return vex.return_int(ret, 0);
}

// Recursion through `map` up to and past the callback limit, then a re-entry from the deepest level.
// Every result must be a clean status: a value only with status 0, and that value must be right.
fn deep_sweep(api: *VexApi) -> i64 {
    let vm: *void = vex.open(api, 0);
    assert(vex.bind(api, vm, "re", "() -> Int", api as *void, re) == 0);
    let src: *u8 = "fn leaf() -> Int { 7 }\nfn g(n: Int) -> Int { if n == 0 { host.re() } else { [n].map(|x| g(x - 1))[0] } }\nfn f(n: Int) -> Int { g(n) }";
    assert(vex.load(api, vm, "sweep.vx", src, vex.c_len(src)) == 0);
    let worst: i64 = 0;
    for n: i64 in 0..700 {
        let args: [VexValue; 1] = [vex.of_int(n)];
        let result: VexValue = vex.of_unit();
        let status: i64 = vex.call(api, vm, "f", &args[0], 1, &result);
        if status == 0 && (result.tag != 1 || result.i != 7) {
            worst = 99;
        }
        if status != 0 && status != 2 {
            worst = 99;
        }
    }
    vex.close(api, vm);
    return worst;
}

fn load_text(api: *VexApi, vm: *void, text: *u8) -> i64 {
    return vex.load(api, vm, "paths.vx", text, vex.c_len(text));
}

fn call0(api: *VexApi, vm: *void, name: *u8) -> i64 {
    let result: VexValue = vex.of_unit();
    return vex.call(api, vm, name, 0 as *VexValue, 0, &result);
}

fn stop_status() -> i64 {
    if vex.stop() {
        return 0;
    }
    return 3;
}

fn main() -> int {
    let api: *VexApi = vex.start();
    assert((*api).ready == 1);
    let vm: *void = vex.open(api, 0);
    assert(vex.bind(api, vm, "fails", "()", api as *void, fails_silently) == 0);
    assert(vex.bind(api, vm, "wrong", "() -> Int", api as *void, wrong_tag) == 0);
    assert(vex.bind(api, vm, "takes_str", "(Str)", api as *void, accepts_str) == 0);
    assert(vex.bind(api, vm, "reenter", "()", api as *void, reenter) == 0);
    assert(vex.bind(api, vm, "reenter_once", "(Int) -> Int", api as *void, reenter_once) == 0);
    assert(vex.bind(api, vm, "stops_the_runtime", "() -> Int", api as *void, stops_the_runtime) == 0);
    assert(load_text(api, vm, "fn ok() -> Int { 7 }\nfn plain(n: Int) { n + 1 }\nfn nz() { host.fails(); }\nfn tag() { host.wrong(); }\nfn reenter_forever() { host.reenter(); }\nfn twice(n: Int) { host.reenter_once(n) }\nfn s(x: Str) { host.takes_str(x); }\nfn stops() -> Int { host.stops_the_runtime() }") == 0);

    report("ok-call", call0(api, vm, "ok"));
    report("nonzero-status", call0(api, vm, "nz"));
    report("wrong-return-tag", call0(api, vm, "tag"));

    let bad: *u8 = alloc(2) as *u8;
    let bytes: []u8 = slice(bad, 2);
    bytes[0] = 255;
    bytes[1] = 0;
    let args: [VexValue; 1] = [vex.of_str(bad, 1)];
    let result: VexValue = vex.of_unit();
    report("bad-utf8-arg", vex.call(api, vm, "s", &args[0], 1, &result));

    let vm2: *void = vex.open(api, 0);
    report("compile", load_text(api, vm2, "fn f( {"));
    report("denied", load_text(api, vm2, "fn f() { io.write_file(\"a\", \"b\"); }"));
    vex.close(api, vm2);

    report("runaway-reentry", call0(api, vm, "reenter_forever"));
    let start: [VexValue; 1] = [vex.of_int(1)];
    report("reentry-ok", vex.call(api, vm, "twice", &start[0], 1, &result));
    report("after-errors", call0(api, vm, "ok"));
    report("deep-sweep", deep_sweep(api));
    let refused: VexValue = vex.of_unit();
    report("stop-during-call", vex.call(api, vm, "stops", 0 as *VexValue, 0, &refused));
    report("stop-during-call-refused", refused.i);
    report("after-refused-stop", call0(api, vm, "ok"));
    let stale: *void = vex.open(api, 0);
    vex.close(api, vm);
    report("stop", stop_status());
    report("stop-twice", stop_status());
    report("after-stop-call", call0(api, stale, "ok"));
    report("after-stop-load", load_text(api, stale, "fn f() { }"));
    report("after-stop-budget", vex.budget(api, stale, 10));
    report("after-stop-bind", vex.bind(api, stale, "x", "()", api as *void, fails_silently));
    if vex.open(api, 0) != (0 as *void) {
        println("after-stop-open:not null");
    }
    vex.close(api, stale);
    vex.fail(api, stale, "ignored");
    println(vex.error(api, stale));
    return 0;
}
