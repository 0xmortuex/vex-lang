// A rule with an arithmetic bug. The compound fee overflows on the large order, and only there.
fn price(quantity: Int, unit_cents: Int, customer: Str) -> Int {
    let subtotal = quantity * unit_cents;
    let fee = subtotal * subtotal * subtotal;
    host.customer_tier(customer);
    subtotal + (fee / subtotal / subtotal) + host.tax_cents(subtotal)
}
