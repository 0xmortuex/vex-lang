// A small JSON-ish parser: recursive descent over a list of characters.
// Demonstrates enums with data, Result, `?`, tuples and string building.
enum Json {
    Null,
    Bool(Bool),
    Num(Int),
    Text(Str),
    Array(List[Json]),
    Object(List[(Str, Json)]),
}

fn skip_ws(cs: List[Str], i: Int) -> Int {
    let mut j = i;
    while j < cs.len() && (cs[j] == " " || cs[j] == "\n" || cs[j] == "\t") {
        j += 1;
    }
    j
}

fn is_digit(c: Str) -> Bool {
    c.len() == 1 && "0123456789".contains(c)
}

fn parse_value(cs: List[Str], start: Int) -> Result[(Json, Int), Str] {
    let i = skip_ws(cs, start);
    if i >= cs.len() {
        return Err("unexpected end of input");
    }
    let c = cs[i];
    if c == "n" { return expect_word(cs, i, "null", Json.Null); }
    if c == "t" { return expect_word(cs, i, "true", Json.Bool(true)); }
    if c == "f" { return expect_word(cs, i, "false", Json.Bool(false)); }
    if c == "\"" { return parse_string(cs, i); }
    if c == "[" { return parse_array(cs, i + 1); }
    if c == "\{" { return parse_object(cs, i + 1); }
    if is_digit(c) || c == "-" { return parse_number(cs, i); }
    Err("unexpected character '{c}' at {i}")
}

fn expect_word(cs: List[Str], i: Int, word: Str, value: Json) -> Result[(Json, Int), Str] {
    let n = word.len();
    if i + n <= cs.len() && cs.slice(i, i + n).join("") == word {
        Ok((value, i + n))
    } else {
        Err("expected '{word}' at {i}")
    }
}

fn parse_number(cs: List[Str], i: Int) -> Result[(Json, Int), Str] {
    let mut j = i;
    if cs[j] == "-" { j += 1; }
    let digits_start = j;
    while j < cs.len() && is_digit(cs[j]) { j += 1; }
    if j == digits_start {
        return Err("expected digits at {i}");
    }
    let text = cs.slice(i, j).join("");
    match text.to_int() {
        Some(n) => Ok((Json.Num(n), j)),
        None => Err("number out of range: {text}"),
    }
}

fn parse_string_raw(cs: List[Str], i: Int) -> Result[(Str, Int), Str] {
    // cs[i] is the opening quote
    let mut j = i + 1;
    let mut out = "";
    while j < cs.len() {
        let c = cs[j];
        if c == "\"" {
            return Ok((out, j + 1));
        }
        if c == "\\" && j + 1 < cs.len() {
            let e = cs[j + 1];
            out = out + (if e == "n" { "\n" } else { e });
            j += 2;
        } else {
            out = out + c;
            j += 1;
        }
    }
    Err("unterminated string starting at {i}")
}

fn parse_string(cs: List[Str], i: Int) -> Result[(Json, Int), Str] {
    let (s, next) = parse_string_raw(cs, i)?;
    Ok((Json.Text(s), next))
}

fn parse_array(cs: List[Str], start: Int) -> Result[(Json, Int), Str] {
    let mut items: List[Json] = [];
    let mut i = skip_ws(cs, start);
    if i < cs.len() && cs[i] == "]" {
        return Ok((Json.Array(items), i + 1));
    }
    while true {
        let (v, next) = parse_value(cs, i)?;
        items.push(v);
        i = skip_ws(cs, next);
        if i >= cs.len() { return Err("unterminated array"); }
        if cs[i] == "," {
            i += 1;
        } else if cs[i] == "]" {
            return Ok((Json.Array(items), i + 1));
        } else {
            return Err("expected ',' or ']' at {i}");
        }
    }
    Err("unreachable")
}

fn parse_object(cs: List[Str], start: Int) -> Result[(Json, Int), Str] {
    let mut fields: List[(Str, Json)] = [];
    let mut i = skip_ws(cs, start);
    if i < cs.len() && cs[i] == "}" {
        return Ok((Json.Object(fields), i + 1));
    }
    while true {
        i = skip_ws(cs, i);
        if i >= cs.len() || cs[i] != "\"" { return Err("expected a string key at {i}"); }
        let (key, after_key) = parse_string_raw(cs, i)?;
        i = skip_ws(cs, after_key);
        if i >= cs.len() || cs[i] != ":" { return Err("expected ':' at {i}"); }
        let (v, next) = parse_value(cs, i + 1)?;
        fields.push((key, v));
        i = skip_ws(cs, next);
        if i >= cs.len() { return Err("unterminated object"); }
        if cs[i] == "," {
            i += 1;
        } else if cs[i] == "}" {
            return Ok((Json.Object(fields), i + 1));
        } else {
            return Err("expected ',' or '\}' at {i}");
        }
    }
    Err("unreachable")
}

fn parse(text: Str) -> Result[Json, Str] {
    let cs = text.chars();
    let (v, next) = parse_value(cs, 0)?;
    if skip_ws(cs, next) != cs.len() {
        return Err("trailing characters at {skip_ws(cs, next)}");
    }
    Ok(v)
}

fn render(j: Json) -> Str {
    match j {
        Json.Null => "null",
        Json.Bool(b) => "{b}",
        Json.Num(n) => "{n}",
        Json.Text(s) => "\"{s}\"",
        Json.Array(items) => "[" + items.map(|x| render(x)).join(",") + "]",
        Json.Object(fields) => "\{" + fields.map(|kv| "\"{kv.0}\":{render(kv.1)}").join(",") + "}",
    }
}

fn depth(j: Json) -> Int {
    match j {
        Json.Array(items) => 1 + items.fold(0, |m, x| m.max(depth(x))),
        Json.Object(fields) => 1 + fields.fold(0, |m, kv| m.max(depth(kv.1))),
        _ => 0,
    }
}

fn main() {
    let inputs = [
        "\{\"name\": \"Vex\", \"tags\": [\"fast\", \"typed\"], \"year\": 2026, \"ok\": true}",
        "[1, [2, [3, [4]]], -5, null]",
        "\{\"a\": [1, 2,}",
        "[1, 2",
        "\"türkçe ğüşiöç\"",
    ];
    for text in inputs {
        match parse(text) {
            Ok(j) => print("ok  depth={depth(j)} {render(j)}"),
            Err(msg) => print("err {msg}"),
        }
    }
}
