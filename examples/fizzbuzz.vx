// FizzBuzz with if/else as an expression and a range loop.
fn fizzbuzz(n: Int) -> Str {
    if n % 15 == 0 {
        "FizzBuzz"
    } else if n % 3 == 0 {
        "Fizz"
    } else if n % 5 == 0 {
        "Buzz"
    } else {
        "{n}"
    }
}

fn main() {
    for i in 1..=20 {
        print(fizzbuzz(i));
    }
}
